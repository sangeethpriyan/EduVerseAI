# Environment
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/eduverse_db

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/eduverse

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=7d

# OAuth2 (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth2 (Microsoft)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector DB / Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=eduverse

# AWS / Object Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=eduverse-files
S3_ENDPOINT=https://s3.amazonaws.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eduverse.com

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Backend Config
API_PORT=3001
API_HOST=0.0.0.0

# Session
SESSION_SECRET=your-session-secret-key

# Security
ENCRYPTION_KEY=your-32-char-encryption-key-here
ENABLE_HTTPS=false

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_OTP_LOGIN=true
ENABLE_OAUTH=true
ENABLE_DOCUMENT_GENERATION=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
